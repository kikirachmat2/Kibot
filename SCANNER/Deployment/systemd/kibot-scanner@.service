[Unit]
Description=KiBot Global Scanner (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot/scripts
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
Environment=PYTHONUNBUFFERED=1
Environment=KIBOT_RUNTIME_ROOT=/home/ubuntu/KiBot
Environment=KIBOT_SCANNER_STATE_DIR=/home/ubuntu/KiBot/state/scanners
Environment=KIBOT_SIGNAL_KEY=SOVEREIGN_DEFAULT_SIGNAL_SECRET
ExecStart=/usr/bin/python3 /home/ubuntu/KiBot/SCANNER/Exchange_Scrapers/ki_%i_scanner.py
Restart=on-failure
RestartSec=15
MemoryMax=128M
CPUQuota=20%
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ki-%i

[Install]
WantedBy=multi-user.target
