[Unit]
Description=KiBot Global Scanner Mesh (Bybit + KuCoin + Crypto.com + MEXC)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
Environment=PYTHONUNBUFFERED=1
Environment=KIBOT_RUNTIME_ROOT=/home/ubuntu/KiBot
Environment=KIBOT_SCANNER_STATE_DIR=/home/ubuntu/KiBot/state/scanners
Environment=KIBOT_MANAGER_HOST=168.110.201.228
Environment=KIBOT_MANAGER_UDP_PORT=9998
Environment=SCAN_INTERVAL_S=30
ExecStart=/usr/bin/python3 /home/ubuntu/KiBot/SG-Scanner/ki_global_scanner_mesh.py
Restart=on-failure
RestartSec=15
MemoryMax=96M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ki-global-scanner-mesh

[Install]
WantedBy=multi-user.target
