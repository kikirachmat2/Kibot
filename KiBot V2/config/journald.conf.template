# /etc/systemd/journald.conf.d/kibot.conf (or edit /etc/systemd/journald.conf)
# Recommended journald configuration for KiBot V2 to prevent disk/swap thrashing.
#
# HOW TO APPLY ON SERVER (RUN MANUALLY AS ROOT):
#   sudo cp config/journald.conf.template /etc/systemd/journald.conf.d/kibot.conf
#   sudo systemctl restart systemd-journald
#   sudo journalctl --vacuum-size=100M

[Journal]
# Storage mode: persistent to disk
Storage=persistent

# Limit total disk space used by all journal files
SystemMaxUse=100M

# Limit disk space that must remain free
SystemKeepFree=1G

# Maximum size of an individual journal file before rotation
SystemMaxFileSize=20M

# Maximum retention time for logs
MaxRetentionSec=7day

# Rate limit burst logging (500 messages per 10 seconds per service)
RateLimitIntervalSec=10s
RateLimitBurst=500
