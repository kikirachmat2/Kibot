[Unit]
Description=KiBot Trinity Dashboard (Support/Web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# Folder sudah kita rename ke SERVER_BATAM
WorkingDirectory=/home/ubuntu/KiBot/SERVER_BATAM/Support/Web
EnvironmentFile=-/home/ubuntu/KiBot/.env.indodax
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
ExecStart=/usr/bin/python3 /home/ubuntu/KiBot/SERVER_BATAM/Support/Web/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-dashboard

[Install]
WantedBy=multi-user.target
