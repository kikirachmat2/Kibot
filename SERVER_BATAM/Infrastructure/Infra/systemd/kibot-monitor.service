[Unit]
Description=KiBot Trinity Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot_manager
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
ExecStart=/usr/bin/python3 SERVER_BATAM/Infrastructure/Automation/trinity_monitor.py
Restart=always
RestartSec=30
MemoryMax=128M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
