[Unit]
Description=KiBot Sovereign High Command (Unified Master)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
Environment=KIBOT_PRIMARY_NODE=1
EnvironmentFile=-/home/ubuntu/KiBot/.env.server

# Cleanup ports before start
ExecStartPre=/bin/sh -c 'sudo fuser -k 9998/udp 9997/udp || true'

ExecStart=/usr/bin/python3 -u SERVER_BATAM/KiBot.py
Restart=always
RestartSec=15
MemoryMax=2G
CPUQuota=90%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-high-command

[Install]
WantedBy=multi-user.target
