[Unit]
Description=Executor Healer Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/KiBot
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/KiBot/SERVER_BATAM/Infrastructure/executor_memory_watchdog.py
