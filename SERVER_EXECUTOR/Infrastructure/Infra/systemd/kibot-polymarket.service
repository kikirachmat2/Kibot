[Unit]
Description=KiBot Polymarket Executor (Batam)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.polymarket
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
Environment=PYTHONUNBUFFERED=1
Environment=KIBOT_RUNTIME_ROOT=/home/ubuntu/KiBot
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiBot/SG-Executor/kibot_polymarket.py
Restart=always
RestartSec=5
MemoryMax=220M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-polymarket

[Install]
WantedBy=multi-user.target
