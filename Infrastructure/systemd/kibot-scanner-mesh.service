[Unit]
Description=KiBot Global SG_SCANNER Mesh (Bybit + KuCoin + Crypto.com + MEXC)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
Environment=PYTHONUNBUFFERED=1
Environment=KIBOT_RUNTIME_ROOT=/home/ubuntu/KiBot
Environment=KIBOT_SCANNER_STATE_DIR=/home/ubuntu/KiBot/state/scanners
Environment=KIBOT_SIGNAL_KEY=SOVEREIGN_DEFAULT_SIGNAL_SECRET
ExecStart=/usr/bin/python3 /home/ubuntu/KiBot/SCANNER/Exchange_Scrapers/ki_global_scanner_mesh.py
Restart=on-failure
RestartSec=15
MemoryMax=256M
CPUQuota=40%
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ki-global-scanner-mesh

[Install]
WantedBy=multi-user.target
