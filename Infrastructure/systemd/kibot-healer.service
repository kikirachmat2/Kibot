[Unit]
Description=KiBot Autonomous Healer
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
Environment=KIBOT_OLLAMA_API_BASE=http://127.0.0.1:11434
Environment=OLLAMA_API_BASE=http://127.0.0.1:11434
ExecStart=/usr/bin/python3 BATAM_MASTER/Infrastructure/Automation/trinity_healer.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-healer

[Install]
WantedBy=multi-user.target
