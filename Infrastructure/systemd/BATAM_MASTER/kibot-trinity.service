[Unit]
Description=KiBot Trinity Autonomous Brain
After=network-online.target tailscaled.service ollama.service
Wants=network-online.target tailscaled.service ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
Environment=KIBOT_MATH_REVIEW_MIN_TRADES=0
Environment=KIBOT_UDP_HOST=100.122.1.109
Environment=KIBOT_UDP_PORT=9999
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
ExecStartPre=/bin/sh -c '/usr/bin/sudo /usr/bin/fuser -k 9999/udp 9998/tcp || true'
ExecStart=/usr/bin/python3 -u BATAM_MASTER/KiBot.py
Restart=always
RestartSec=10
MemoryMax=8000M
CPUQuota=90%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-trinity

[Install]
WantedBy=multi-user.target
