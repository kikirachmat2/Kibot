[Unit]
Description=KiBot Polymarket Gateway (Python)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiBot/Executor/Core/Python_Executor/polymarket_executor.py
Restart=always
RestartSec=5
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-polymarket

[Install]
WantedBy=multi-user.target
