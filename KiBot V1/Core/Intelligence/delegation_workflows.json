{
  "version": "1.0",
  "system": "KiBot Sovereign",
  "flows": [
    {
      "name": "signal_discovery",
      "owner": "scanner",
      "inputs": ["indodax_scanner"],
      "outputs": ["hmac_signed_signals", "stage_metadata"],
      "constraints": ["dedupe_by_uid", "proxy_structural_fallback", "no_noise_forwarding"]
    },
    {
      "name": "council_deliberation",
      "owner": "sovereign_council",
      "inputs": ["signals", "whatif_snapshot", "evidence_bundle", "daily_state", "portfolio_state", "antagonist_view", "possibility_view", "deadline_pressure"],
      "outputs": ["mandate", "decision_state", "learning_probe", "recovery_mode"],
      "constraints": ["green_target_not_percentage", "none_if_weak", "controlled_recovery_only"]
    },
    {
      "name": "executor_gate",
      "owner": "indodax_executor",
      "inputs": ["mandate", "balance", "fee_model", "spread", "momentum", "confidence"],
      "outputs": ["order_result", "trade_state"],
      "constraints": ["live_gate_required", "hard_risk_rules", "fee_spread_balance_checks"]
    },
    {
      "name": "verification_loop",
      "owner": "verifier",
      "inputs": ["order_result", "pnl", "active_trades", "risk_state", "system_health"],
      "outputs": ["midnight_report", "state_updates", "escalation_if_needed"],
      "constraints": ["telegram_throttled", "recover_self_first"]
    },
    {
      "name": "maintenance_loop",
      "owner": "janitor",
      "inputs": ["disk", "ollama", "redis", "services", "cache_growth"],
      "outputs": ["cleanup", "restart_actions", "model_sync"],
      "constraints": ["no_duplicate_services", "safe_cleanup_only"]
    }
  ],
  "stages": [
    "CONTINUATION",
    "RECLAIM",
    "LATE_RECLAIM",
    "RANGE_BREAK_RECLAIM",
    "SUPPORT_BOUNCE",
    "PIVOT_RECLAIM",
    "MATURE",
    "IGNITION"
  ]
}
