[Unit]
Description=KiBot Daily Reset Coordinator
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=/home/ubuntu/KiBot/.env
ExecStart=/home/ubuntu/KiBot/.venv/bin/python3 -m Core.Decision.daily_reset_coordinator
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
