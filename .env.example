# ==============================================================================
# KiBot V3 Environment Configuration Template
# Copy this file to .env and configure real credentials.
# CRITICAL: Keep permissions restricted (chmod 600 .env)
# ==============================================================================

# Indodax API Credentials (Read + Trade, Strictly NO Withdrawal permission)
INDODAX_API_KEY=
INDODAX_SECRET=

# Telegram Bot Credentials for Scheduled & Interactive Alerts (SG1 Main Bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server 2 Independent Telegram Bot (Task 4: Dedicated token for watchdog alerts)
# Allows Server 2 to alert Supervisor directly even if SG1 or its credentials fail
WATCHDOG_TELEGRAM_BOT_TOKEN=
WATCHDOG_TELEGRAM_CHAT_ID=

# HTTP Health Check Endpoint (SG1 private endpoint for Watchdog & Batam)
# Strictly bound to private network (Tailscale IP 100.105.139.21 or 0.0.0.0 without public iptables port)
HEALTH_PORT=8789
HEALTH_HOST=0.0.0.0

# Watchdog Target Host (Tailscale IP of SG1)
SG1_HOST=100.105.139.21
SG1_HEALTH_PORT=8789

# Execution Mode: PAPER (Simulation) or LIVE (Real Orders)
MODE=PAPER

# Persistent SQLite WAL Database Path
DB_PATH=/home/ubuntu/kibot_v3_data/kibot_v3.db

# Non-Negotiable Safety Invariant
API_KEY_WITHDRAWAL_DISABLED=true
