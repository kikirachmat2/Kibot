#!/usr/bin/env bash
set -euo pipefail

# KiBot Sovereign Control Wrapper
# One-command operator entrypoint for systemd-managed services and Ollama model hygiene.

CORE_SERVICES=(
  redis-server
  ollama
  kibot-capital-governor
  kibot-master
  kibot-scanner
  kibot-executor
  kibot-executor-polymarket
  kibot-ai-scout
  kibot-janitor
  kibot-dashboard
)

CANONICAL_MODELS=(
  "qwen2.5:0.5b"
  "qwen2.5:1.5b"
  "qwen2.5:3b"
  "llama3.2:3b"
  "deepseek-r1:7b"
  "mistral:7b"
  "qwen2.5-coder:3b"
  "nomic-embed-text:latest"
)

if [[ $# -lt 1 ]]; then
  cat <<'EOF'
Usage:
  kibotctl status
  kibotctl doctor
  kibotctl reset-pnl
  kibotctl up
  kibotctl down
  kibotctl restart
  kibotctl models
  kibotctl sync-models
  kibotctl tools
  kibotctl install-tools
  kibotctl pull <model>
  kibotctl logs [service...]
  kibotctl deploy
  kibotctl backup
EOF
  exit 1
fi

if ! command -v systemctl >/dev/null 2>&1; then
  echo "kibotctl requires systemd. Run this on the Batam server host." >&2
  exit 1
fi

SYSTEMCTL_PREFIX=()
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    SYSTEMCTL_PREFIX=(sudo)
  else
    echo "root or sudo is required for systemctl operations." >&2
    exit 1
  fi
fi

systemctl_cmd() {
  "${SYSTEMCTL_PREFIX[@]}" systemctl "$@"
}

section() {
  printf '\n=== %s ===\n' "$1"
}

service_status() {
  local svc status
  for svc in "${CORE_SERVICES[@]}"; do
    status="$(systemctl is-active "$svc" 2>/dev/null || true)"
    printf '%-30s %s\n' "$svc" "${status:-unknown}"
  done
}

port_status() {
  section "UDP"
  ss -ulnp | grep -E '9990|9991|9998' || echo "No KiBot UDP listeners found."
  section "TCP"
  ss -tlnp | grep -E '11434|11600|6379|8787' || echo "No KiBot TCP listeners found."
}

kill_dashboard_port() {
  if command -v fuser >/dev/null 2>&1; then
    fuser -k 8787/tcp >/dev/null 2>&1 || true
  fi
  pkill -f 'uvicorn Core.Intelligence.kibot_dashboard:app --host 0.0.0.0 --port 8787' >/dev/null 2>&1 || true
}

model_list() {
  ollama list || true
}

model_ps() {
  ollama ps || true
}

resolve_aider_cmd() {
  if command -v aider >/dev/null 2>&1; then
    command -v aider
    return
  fi

  if [[ -x "${HOME}/.local/bin/aider" ]]; then
    printf '%s\n' "${HOME}/.local/bin/aider"
    return
  fi

  return 1
}

cmd_status() {
  section "System"
  nproc
  free -h
  df -h /
  section "Services"
  service_status
  port_status
  section "Ollama Models"
  model_list
  section "Ollama Running Models"
  model_ps
}

cmd_tools() {
  section "GitHub CLI"
  if command -v gh >/dev/null 2>&1; then
    gh auth status || true
  else
    echo "gh not installed"
  fi

  section "Copilot CLI"
  if command -v copilot >/dev/null 2>&1; then
    copilot --version || true
  else
    echo "copilot not installed"
  fi

  section "Aider"
  if aider_cmd="$(resolve_aider_cmd 2>/dev/null)"; then
    "$aider_cmd" --version || true
  else
    echo "aider not installed"
    echo "Hint: pipx install aider-chat && export PATH=\"\$HOME/.local/bin:\$PATH\""
  fi
}

cmd_doctor() {
  cmd_status
  section "Python Runtime"
  local py_bin="/home/ubuntu/KiBot/.venv/bin/python3"
  if [[ -n "${SUDO_USER:-}" ]]; then
    py_bin="sudo -u $SUDO_USER /home/ubuntu/KiBot/.venv/bin/python3"
  fi
  $py_bin - <<'PY'
checks = [
    ("talib", "import talib"),
    ("ddgs", "from ddgs import DDGS"),
    ("numpy", "import numpy"),
    ("pandas", "import pandas"),
    ("web3", "from web3 import Web3"),
    ("py_clob_client", "from py_clob_client.client import ClobClient"),
    ("redis", "import redis"),
    ("httpx", "import httpx"),
    ("aiohttp", "import aiohttp"),
    ("nest_asyncio", "import nest_asyncio"),
    ("ta", "import ta"),
]
for name, stmt in checks:
    try:
        exec(stmt)
        print(f"✅ {name}")
    except Exception as exc:
        print(f"❌ {name}: {exc}")
PY
  cmd_tools
}

cmd_up() {
  section "Reloading systemd"
  systemctl_cmd daemon-reload
  for svc in "${CORE_SERVICES[@]}"; do
    if [[ "$svc" == "kibot-dashboard" ]]; then
      kill_dashboard_port
    fi
    echo "[start] $svc"
    systemctl_cmd restart "$svc"
  done
  cmd_status
}

cmd_down() {
  local svc
  for ((i=${#CORE_SERVICES[@]}-1; i>=0; i--)); do
    svc="${CORE_SERVICES[$i]}"
    if [[ "$svc" == "kibot-dashboard" ]]; then
      kill_dashboard_port
    fi
    echo "[stop] $svc"
    systemctl_cmd stop "$svc" || true
  done
  section "Services"
  service_status
}

cmd_restart() {
  cmd_down
  cmd_up
}

cmd_models() {
  section "Ollama Models"
  model_list
  section "Running"
  model_ps
}

cmd_pull() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: kibotctl pull <model>" >&2
    exit 1
  fi
  shift
  ollama pull "$@"
}

cmd_sync_models() {
  local installed model missing=0
  installed="$(ollama list 2>/dev/null | awk 'NR>1 {print $1}' || true)"
  for model in "${CANONICAL_MODELS[@]}"; do
    if ! grep -qx "$model" <<<"$installed"; then
      echo "[pull] $model"
      ollama pull "$model"
      missing=1
    else
      echo "[ok]   $model"
    fi
  done
  if [[ "$missing" -eq 0 ]]; then
    echo "All canonical Ollama models already present."
  fi
}

cmd_install_tools() {
  section "GitHub CLI"
  if command -v gh >/dev/null 2>&1; then
    gh auth status || true
  else
    echo "gh missing. Install via GitHub CLI package for your host OS."
  fi

  section "Copilot CLI"
  if command -v copilot >/dev/null 2>&1; then
    copilot --version || true
  else
    echo "copilot missing. Install Copilot CLI on the server host."
  fi

  section "Aider"
  if aider_cmd="$(resolve_aider_cmd 2>/dev/null)"; then
    "$aider_cmd" --version || true
    echo "Aider already installed."
  elif command -v pipx >/dev/null 2>&1; then
    echo "[install] pipx install aider-chat"
    pipx install aider-chat || true
  else
    echo "pipx missing. Install pipx first, then run: pipx install aider-chat"
  fi
}

cmd_logs() {
  if [[ $# -eq 0 ]]; then
    journalctl -u kibot-master -n 80 --no-pager
    return
  fi
  local args=()
  local svc
  for svc in "$@"; do
    args+=("-u" "$svc")
  done
  journalctl -n 80 --no-pager "${args[@]}"
}

cmd_deploy() {
  local script_dir
  script_dir="$(dirname "$0")"
  if [[ -x "${script_dir}/kibot-pre-deploy.sh" ]]; then
    "${script_dir}/kibot-pre-deploy.sh"
  else
    echo "kibot-pre-deploy.sh not found or not executable." >&2
    exit 1
  fi
}

cmd_backup() {
  local script_dir
  script_dir="$(dirname "$0")"
  if [[ -x "${script_dir}/kibot-backup.sh" ]]; then
    "${script_dir}/kibot-backup.sh"
  else
    echo "kibot-backup.sh not found or not executable." >&2
    exit 1
  fi
}

cmd_reset_pnl() {
  section "Manual PnL Anchor Reset"
  local py_bin="/home/ubuntu/KiBot/.venv/bin/python3"
  if [[ -n "${SUDO_USER:-}" ]]; then
    py_bin="sudo -u $SUDO_USER /home/ubuntu/KiBot/.venv/bin/python3"
  fi
  # Fallback to local system python if venv not present (e.g. during local tests)
  if [[ ! -f "/home/ubuntu/KiBot/.venv/bin/python3" ]]; then
    py_bin="python3"
  fi
  PYTHONPATH="." "$py_bin" Core/Treasury/capital_governor.py --reset-pnl
}

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  reset-pnl) shift; cmd_reset_pnl "$@" ;;
  up) shift; cmd_up "$@" ;;
  down) shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  models) shift; cmd_models "$@" ;;
  sync-models) shift; cmd_sync_models "$@" ;;
  tools) shift; cmd_tools "$@" ;;
  install-tools) shift; cmd_install_tools "$@" ;;
  pull) cmd_pull "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  deploy) shift; cmd_deploy "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    exit 1
    ;;
esac
