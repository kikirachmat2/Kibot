#!/usr/bin/env bash
set -euo pipefail

# KiBot Sovereign Control Wrapper
# One-command operator entrypoint for systemd-managed services and Ollama model hygiene.

CORE_SERVICES=(
  redis-server
  ollama
  kibot-capital-governor
  kibot-master
  kibot-scanner
  kibot-scanner-health
  kibot-executor
  kibot-executor-polymarket
  kibot-autonomous-brain
  kibot-indodax-director
  kibot-phantom-brain
  kibot-target-board
  kibot-telemetry
  kibot-workflow-supervisor
  kibot-daily-reset
  kibot-pumpfun
  kibot-base
  kibot-future-web3
  kibot-web3-exit
  kibot-ai-scout
  kibot-janitor
  kibot-dashboard
  kibot-cloudflared
)

CANONICAL_MODELS=(
  "qwen2.5:0.5b"
  "qwen2.5:1.5b"
  "qwen2.5:3b"
  "llama3.2:3b"
  "deepseek-r1:7b"
  "mistral:7b"
  "qwen2.5-coder:3b"
  "nomic-embed-text:latest"
)

if [[ $# -lt 1 ]]; then
  cat <<'EOF'
Usage:
  kibotctl status
  kibotctl doctor
  kibotctl deposit-notify <amount_idr> [note]
  kibotctl reset-pnl
  kibotctl learn-status
  kibotctl variant-compare
  kibotctl ai-report [--refresh]
  kibotctl up
  kibotctl down
  kibotctl restart
  kibotctl models
  kibotctl sync-models
  kibotctl tools
  kibotctl install-tools
  kibotctl pull <model>
  kibotctl logs [service...]
  kibotctl deploy
  kibotctl backup
EOF
  exit 1
fi

if ! command -v systemctl >/dev/null 2>&1; then
  echo "kibotctl requires systemd. Run this on the Batam server host." >&2
  exit 1
fi

SYSTEMCTL_PREFIX=()
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    SYSTEMCTL_PREFIX=(sudo)
  else
    echo "root or sudo is required for systemctl operations." >&2
    exit 1
  fi
fi

systemctl_cmd() {
  "${SYSTEMCTL_PREFIX[@]}" systemctl "$@"
}

section() {
  printf '\n=== %s ===\n' "$1"
}

service_status() {
  local svc status
  for svc in "${CORE_SERVICES[@]}"; do
    status="$(systemctl is-active "$svc" 2>/dev/null || true)"
    printf '%-30s %s\n' "$svc" "${status:-unknown}"
  done
}

port_status() {
  section "UDP"
  ss -ulnp | grep -E '9990|9991|9998' || echo "No KiBot UDP listeners found."
  section "TCP"
  ss -tlnp | grep -E '11434|11600|6379|8787' || echo "No KiBot TCP listeners found."
}

kill_dashboard_port() {
  if command -v fuser >/dev/null 2>&1; then
    fuser -k 8787/tcp >/dev/null 2>&1 || true
  fi
  pkill -f 'uvicorn Core.Intelligence.kibot_dashboard:app --host 0.0.0.0 --port 8787' >/dev/null 2>&1 || true
}

model_list() {
  ollama list || true
}

model_ps() {
  ollama ps || true
}

resolve_aider_cmd() {
  if command -v aider >/dev/null 2>&1; then
    command -v aider
    return
  fi

  if [[ -x "${HOME}/.local/bin/aider" ]]; then
    printf '%s\n' "${HOME}/.local/bin/aider"
    return
  fi

  return 1
}

cmd_status() {
  section "System"
  nproc
  free -h
  df -h /
  section "Services"
  service_status
  port_status
  section "Ollama Models"
  model_list
  section "Ollama Running Models"
  model_ps
}

cmd_tools() {
  section "GitHub CLI"
  if command -v gh >/dev/null 2>&1; then
    gh auth status || true
  else
    echo "gh not installed"
  fi

  section "Copilot CLI"
  if command -v copilot >/dev/null 2>&1; then
    copilot --version || true
  else
    echo "copilot not installed"
  fi

  section "Aider"
  if aider_cmd="$(resolve_aider_cmd 2>/dev/null)"; then
    "$aider_cmd" --version || true
  else
    echo "aider not installed"
    echo "Hint: pipx install aider-chat && export PATH=\"\$HOME/.local/bin:\$PATH\""
  fi

  section "Crush"
  if command -v crush >/dev/null 2>&1; then
    crush --version || crush --help | head -20 || true
  else
    echo "crush not installed"
    echo "Hint: npm install -g @charmland/crush"
  fi
}

cmd_doctor() {
  cmd_status
  section "Python Runtime"
  local py_bin="/home/ubuntu/KiBot/.venv/bin/python3"
  if [[ -n "${SUDO_USER:-}" ]]; then
    py_bin="sudo -u $SUDO_USER /home/ubuntu/KiBot/.venv/bin/python3"
  fi
  $py_bin - <<'PY'
checks = [
    ("talib", "import talib"),
    ("ddgs", "from ddgs import DDGS"),
    ("numpy", "import numpy"),
    ("pandas", "import pandas"),
    ("web3", "from web3 import Web3"),
    ("py_clob_client", "from py_clob_client.client import ClobClient"),
    ("redis", "import redis"),
    ("httpx", "import httpx"),
    ("aiohttp", "import aiohttp"),
    ("nest_asyncio", "import nest_asyncio"),
    ("ta", "import ta"),
]
for name, stmt in checks:
    try:
        exec(stmt)
        print(f"✅ {name}")
    except Exception as exc:
        print(f"❌ {name}: {exc}")
PY
  cmd_tools
}

cmd_up() {
  section "Reloading systemd"
  systemctl_cmd daemon-reload
  for svc in "${CORE_SERVICES[@]}"; do
    if [[ "$svc" == "kibot-dashboard" ]]; then
      kill_dashboard_port
    fi
    echo "[start] $svc"
    systemctl_cmd restart "$svc"
  done
  cmd_status
}

cmd_down() {
  local svc
  for ((i=${#CORE_SERVICES[@]}-1; i>=0; i--)); do
    svc="${CORE_SERVICES[$i]}"
    if [[ "$svc" == "kibot-dashboard" ]]; then
      kill_dashboard_port
    fi
    echo "[stop] $svc"
    systemctl_cmd stop "$svc" || true
  done
  section "Services"
  service_status
}

cmd_restart() {
  cmd_down
  cmd_up
}

cmd_models() {
  section "Ollama Models"
  model_list
  section "Running"
  model_ps
}

cmd_pull() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: kibotctl pull <model>" >&2
    exit 1
  fi
  shift
  ollama pull "$@"
}

cmd_sync_models() {
  local installed model missing=0
  installed="$(ollama list 2>/dev/null | awk 'NR>1 {print $1}' || true)"
  for model in "${CANONICAL_MODELS[@]}"; do
    if ! grep -qx "$model" <<<"$installed"; then
      echo "[pull] $model"
      ollama pull "$model"
      missing=1
    else
      echo "[ok]   $model"
    fi
  done
  if [[ "$missing" -eq 0 ]]; then
    echo "All canonical Ollama models already present."
  fi
}

cmd_install_tools() {
  section "GitHub CLI"
  if command -v gh >/dev/null 2>&1; then
    gh auth status || true
  else
    echo "gh missing. Install via GitHub CLI package for your host OS."
  fi

  section "Copilot CLI"
  if command -v copilot >/dev/null 2>&1; then
    copilot --version || true
  else
    echo "copilot missing. Install Copilot CLI on the server host."
  fi

  section "Aider"
  if aider_cmd="$(resolve_aider_cmd 2>/dev/null)"; then
    "$aider_cmd" --version || true
    echo "Aider already installed."
  elif command -v pipx >/dev/null 2>&1; then
    echo "[install] pipx install aider-chat"
    pipx install aider-chat || true
  else
    echo "pipx missing. Install pipx first, then run: pipx install aider-chat"
  fi

  section "Crush"
  if command -v crush >/dev/null 2>&1; then
    crush --version || true
    echo "Crush already installed."
  elif command -v npm >/dev/null 2>&1; then
    echo "[install] npm install -g @charmland/crush"
    npm install -g @charmland/crush || true
  else
    echo "npm missing. Install Node/npm first, then run: npm install -g @charmland/crush"
  fi
}

cmd_logs() {
  if [[ $# -eq 0 ]]; then
    journalctl -u kibot-master -n 80 --no-pager
    return
  fi
  local args=()
  local svc
  for svc in "$@"; do
    args+=("-u" "$svc")
  done
  journalctl -n 80 --no-pager "${args[@]}"
}

cmd_deploy() {
  local script_dir
  script_dir="$(dirname "$0")"
  if [[ -x "${script_dir}/kibot-pre-deploy.sh" ]]; then
    "${script_dir}/kibot-pre-deploy.sh"
  else
    echo "kibot-pre-deploy.sh not found or not executable." >&2
    exit 1
  fi
}

cmd_backup() {
  local script_dir
  script_dir="$(dirname "$0")"
  if [[ -x "${script_dir}/kibot-backup.sh" ]]; then
    "${script_dir}/kibot-backup.sh"
  else
    echo "kibot-backup.sh not found or not executable." >&2
    exit 1
  fi
}

cmd_reset_pnl() {
  section "Manual PnL Anchor Reset"
  local py_bin="/home/ubuntu/KiBot/.venv/bin/python3"
  if [[ -n "${SUDO_USER:-}" ]]; then
    py_bin="sudo -u $SUDO_USER /home/ubuntu/KiBot/.venv/bin/python3"
  fi
  PYTHONPATH="." "$py_bin" Core/Treasury/capital_governor.py --reset-pnl
}

cmd_deposit_notify() {
  section "Operator Deposit Notification"
  local py_bin="/home/ubuntu/KiBot/.venv/bin/python3"
  if [[ ! -f "/home/ubuntu/KiBot/.venv/bin/python3" ]]; then
    py_bin="python3"
  fi
  PYTHONPATH="." "$py_bin" Core/Support/deposit_cli.py "$@"
}

cmd_learn_status() {
  section "KiBot Bayesian Learning & Graduation Status"
  local py_bin="/home/ubuntu/KiBot/.venv/bin/python3"
  if [[ ! -f "$py_bin" ]]; then
    py_bin="python3"
  fi
  PYTHONPATH="." "$py_bin" -c "
import json
from pathlib import Path
state_dir = Path('/home/ubuntu/KiBot/state')
learn_path = state_dir / 'learning_state.json'
grad_path = state_dir / 'graduated_strategies.json'
eq_path = state_dir / 'paper_equity.json'

print('=== PAPER EQUITY CURVE (Rp 5,000,000 IDR Bankroll) ===')
if eq_path.exists():
    try:
        eq = json.loads(eq_path.read_text(encoding='utf-8'))
        init_b = float(eq.get('initial_bankroll_idr', 5000000.0))
        curr_e = float(eq.get('current_equity_idr', init_b))
        tot_pnl = float(eq.get('total_pnl_idr', 0.0))
        trades = int(eq.get('total_paper_trades', 0))
        wins = int(eq.get('winning_trades', 0))
        wr = float(eq.get('win_rate_pct', 0.0))
        print(f'  Initial Bankroll: Rp {init_b:,.2f} IDR')
        print(f'  Current Equity:   Rp {curr_e:,.2f} IDR (PnL: Rp {tot_pnl:+,.2f})')
        print(f'  Closed Trades:    {trades:d} (Wins: {wins:d}, Win Rate: {wr:.1f}%)')
    except Exception as e:
        print(f'Error reading paper equity: {e}')
else:
    print('  Initial Bankroll: Rp 5,000,000.00 IDR (Current Equity: Rp 5,000,000.00 IDR)')
    print('  (no paper trades closed yet today)')

print('\n=== BAYESIAN PAIR STATS ===')
if learn_path.exists():
    try:
        content = learn_path.read_text(encoding='utf-8')
        payload = content.rsplit('|', 1)[0] if '|' in content else content
        data = json.loads(payload)
        print(f'Total Pairs Tracked: {len(data)}')
        sorted_pairs = sorted(
            data.items(),
            key=lambda x: (x[1].get('alpha', 1) / max(1e-9, x[1].get('alpha', 1) + x[1].get('beta', 1))),
            reverse=True
        )
        for pair, stats in sorted_pairs[:10]:
            trades = stats.get('trade_count', 0)
            a = stats.get('alpha', 1)
            b = stats.get('beta', 1)
            wr = (a / max(1e-9, a + b)) * 100
            verdict = stats.get('historian_verdict', 'UNKNOWN')
            print(f'  {pair:18s} | Trades: {trades:3d} | WinProb: {wr:5.1f}% | Verdict: {verdict}')
    except Exception as e:
        print(f'Error reading learning state: {e}')
else:
    print('(learning_state.json not created yet — waiting for closed paper trades)')

print('\n=== GRADUATED STRATEGIES ===')
if grad_path.exists():
    try:
        data = json.loads(grad_path.read_text(encoding='utf-8'))
        print(f'Total Graduated/Tracked: {len(data)}')
        for k, v in data.items():
            st = v.get('status', '?')
            ev = v.get('ev_pct', 0.0)
            ss = v.get('sample_size', 0)
            print(f'  {k:25s} | Status: {st:20s} | EV: {ev:+.2f}% | Samples: {ss}')
    except Exception as e:
        print(f'Error reading graduated strategies: {e}')
else:
    print('(graduated_strategies.json not created yet — accumulating paper trades)')
"
}

cmd_variant_compare() {
  python3 -c "
import json
from pathlib import Path
from Core.Intelligence.strategy_stats import get_stats_aggregator
from Core.Intelligence.paper_trade_tracker import VARIANT_CONFIGS

agg = get_stats_aggregator()
agg.refresh_if_needed(force=True)

variants = ['CONSERVATIVE', 'AGGRESSIVE', 'DEFAULT', 'AI_ASSISTED']
state_dir = Path('state')

print('\n========================================================================================')
print('                         KIBOT MULTI-VARIANT PAPER TRADING PERFORMANCE')
print('========================================================================================')
printf_fmt = '%-15s | %-12s | %-10s | %-12s | %-12s | %-12s\n'
print(printf_fmt % ('VARIANT', 'BANKROLL', 'CLOSED', 'WIN RATE', 'AVG PNL', 'EQUITY (IDR)'))
print('-' * 88)

for var in variants:
    summary = agg.get_variant_summary(var)
    eq_file = state_dir / ('paper_equity.json' if var == 'DEFAULT' else f'paper_equity_{var.lower()}.json')
    bankroll = 5000000.0
    equity = bankroll
    total_pnl = 0.0
    
    if eq_file.exists():
        try:
            eq = json.loads(eq_file.read_text(encoding='utf-8'))
            bankroll = float(eq.get('initial_bankroll_idr', bankroll))
            equity = float(eq.get('current_equity_idr', bankroll))
            total_pnl = float(eq.get('total_pnl_idr', 0.0))
        except Exception:
            pass
            
    wr_str = f'{summary.win_rate * 100:.1f}%' if summary.total_trades > 0 else 'N/A'
    pnl_str = f'Rp{total_pnl:+,.0f}'
    eq_str = f'Rp{equity:,.0f}'
    bkr_str = f'Rp{bankroll:,.0f}'
    
    print(printf_fmt % (var, bkr_str, summary.total_trades, wr_str, pnl_str, eq_str))

print('========================================================================================\n')
"
cmd_ai_report() {
  local refresh=0
  if [[ "${1:-}" == "--refresh" ]]; then
    refresh=1
  fi
  local py_bin="/home/ubuntu/KiBot/.venv/bin/python3"
  if [[ ! -x "$py_bin" ]]; then
    py_bin="python3"
  fi
  $py_bin - "$refresh" <<'PY'
import sys
import json
from pathlib import Path
from Core.Intelligence.ai_performance_analyst import run_performance_analysis, get_latest_report

refresh = sys.argv[1] == "1" if len(sys.argv) > 1 else False

if refresh:
    print("⏳ Running on-demand AI performance analysis via Mistral...")
    res = run_performance_analysis(send_telegram=False)
else:
    res = get_latest_report()
    if not res:
        print("ℹ️ No cached AI report found. Generating fresh report...")
        res = run_performance_analysis(send_telegram=False)

print('\n========================================================================================')
print('                         KIBOT AI PERFORMANCE ANALYST REPORT')
print('========================================================================================')
ts = res.get('timestamp_wib') or res.get('metrics', {}).get('collected_at', 'N/A')
print(f'Report Timestamp (WIB): {ts}')
print(f'Report Status         : {res.get("status", "UNKNOWN")}')
print('-' * 88)

ai_rep = res.get('ai_report') or {}
print('\n📝 ANALISIS & OBSERVASI (Mistral Out-of-Band Analyst):')
print(ai_rep.get('summary_text', 'Laporan tidak tersedia.'))

obs = ai_rep.get('observations') or []
if obs:
    print('\n🔍 POIN OBSERVASI:')
    for item in obs:
        print(f'  • {item}')

hyp = ai_rep.get('hypotheses') or []
if hyp:
    print('\n💡 HIPOTESIS PENYEBAB (Bukan Kesimpulan Pasti):')
    for item in hyp:
        print(f'  • {item}')

sug = ai_rep.get('suggested_investigation_areas') or []
if sug:
    print('\n🎯 REKOMENDASI AREA INVESTIGASI OPERATOR:')
    for item in sug:
        print(f'  • {item}')

print('\n========================================================================================\n')
PY
}

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  deposit-notify) shift; cmd_deposit_notify "$@" ;;
  reset-pnl) shift; cmd_reset_pnl "$@" ;;
  learn-status) shift; cmd_learn_status "$@" ;;
  variant-compare) shift; cmd_variant_compare "$@" ;;
  ai-report) shift; cmd_ai_report "$@" ;;
  up) shift; cmd_up "$@" ;;
  down) shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  models) shift; cmd_models "$@" ;;
  sync-models) shift; cmd_sync_models "$@" ;;
  tools) shift; cmd_tools "$@" ;;
  install-tools) shift; cmd_install_tools "$@" ;;
  pull) cmd_pull "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  deploy) shift; cmd_deploy "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  *)
    echo "Unknown command: ${1:-}" >&2
    exit 1
    ;;
esac
