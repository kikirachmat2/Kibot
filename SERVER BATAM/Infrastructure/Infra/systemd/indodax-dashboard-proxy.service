[Unit]
Description=KiBot Trinity Dashboard (Support/Web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# Gunakan kutipan untuk folder berspasi, jangan backslash ganda
WorkingDirectory="/home/ubuntu/KiBot/SERVER BATAM/Support/Web"
EnvironmentFile=-/home/ubuntu/KiBot/.env.indodax
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
# Pastikan path ke python script juga dalam kutipan
ExecStart=/usr/bin/python3 "/home/ubuntu/KiBot/SERVER BATAM/Support/Web/dashboard.py"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-dashboard

[Install]
WantedBy=multi-user.target
