[Unit]
Description=KiBot Trinity Dashboard (Support/Web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# Folder sudah kita rename ke BATAM_MASTER
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.indodax
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
Environment=PYTHONPATH=.
ExecStart=/usr/bin/python3 BATAM_MASTER/Support/Web/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-dashboard

[Install]
WantedBy=multi-user.target
