[Unit]
Description=KiBot Telegram Monitor & Ops Chat
After=network-online.target kibot-trinity.service
Wants=network-online.target kibot-trinity.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot_manager
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
Environment=KIBOT_OLLAMA_FAST_MODEL=qwen2.5:0.5b
Environment=KIBOT_OLLAMA_MODEL=qwen2.5:1.5b
Environment=KIBOT_OLLAMA_DEEP_MODEL=qwen2.5:3b
Environment=KIBOT_OLLAMA_FAST_TIMEOUT_SEC=60
Environment=KIBOT_OLLAMA_TELEGRAM_TIMEOUT_SEC=45
ExecStart=/usr/bin/python3 -u Batam/Core_Logic/telegram_commander.py
Restart=always
RestartSec=5
MemoryMax=120M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ki-telegram-monitor

[Install]
WantedBy=multi-user.target
