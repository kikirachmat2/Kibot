[Unit]
Description=Lazarus Ampere Hunter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ampere-hunt
EnvironmentFile=-/home/ubuntu/KiBot/.env
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
EnvironmentFile=-/home/ubuntu/ampere-hunt/.env.ampere
Environment=PATH=/home/ubuntu/ampere-hunt/venv/bin:/home/ubuntu/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AVAILABILITY_DOMAIN_LIST=FAmY:AP-SINGAPORE-1-AD-1,FAmY:AP-SINGAPORE-1-AD-2,FAmY:AP-SINGAPORE-1-AD-3
Environment=OCI_PROFILE=SINGAPORE
Environment=SSH_KEY_FILE=/home/ubuntu/.ssh/lazarus_ampere.pub
Environment=KIBOT_TELEGRAM_CHAT_ID=1346696386
ExecStart=/bin/bash -lc 'cd /home/ubuntu/ampere-hunt && ./lazarus_ampere.sh >> /home/ubuntu/logs/lazarus_ampere.log 2>&1'
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
