[Unit]
Description=KiBot Data Analyst
After=network-online.target kibot-manager.service
Wants=network-online.target kibot-manager.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot_manager
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/KiBot/Batam/Support/Audit_Testing/kibot_analyst.py
Restart=on-failure
RestartSec=30
MemoryMax=50M

[Install]
WantedBy=multi-user.target
