[Unit]
Description=KiBot Server Guardian
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot_manager
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 scripts/kibot_guardian.py
NotifyAccess=all
WatchdogSec=180
Restart=always
RestartSec=30
MemoryMax=40M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
