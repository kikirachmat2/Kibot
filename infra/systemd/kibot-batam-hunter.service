[Unit]
Description=OCI ARM Catcher for Batam Tenancy (ap-batam-1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBotV2
Environment="PYTHONPATH=/home/ubuntu/KiBotV2/KiBot V2"
EnvironmentFile=-/home/ubuntu/KiBotV2/.env
ExecStart=/home/ubuntu/.local/bin/python3 /home/ubuntu/KiBotV2/infra/oci-arm-catcher-batam.py --interval 35
Restart=always
RestartSec=30
MemoryMax=60M
CPUQuota=10%

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
