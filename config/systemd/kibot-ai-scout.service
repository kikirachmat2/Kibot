[Unit]
Description=KiBot AI World Scout (Intelligence Scanner)
After=network-online.target kibot-master.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env
EnvironmentFile=-/home/ubuntu/KiBot/.env.kiv
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
ExecStart=/home/ubuntu/KiBot/.venv/bin/python3 -u Core/Intelligence/kibot_ai_scout.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-ai-scout

[Install]
WantedBy=multi-user.target
