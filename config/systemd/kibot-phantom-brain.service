[Unit]
Description=KiBot Phantom Live Brain
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=/home/ubuntu/KiBot/.env
ExecStart=/home/ubuntu/KiBot/.venv/bin/python3 -m Core.Decision.phantom_live_brain
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
