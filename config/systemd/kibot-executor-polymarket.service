[Unit]
Description=KiBot Polymarket Executor Node
After=network-online.target kibot-master.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env
EnvironmentFile=-/home/ubuntu/KiBot/.env.kiv
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
ExecStart=/usr/bin/python3 -u Core/Executors/Phantom/polymarket_executor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-executor-polymarket

[Install]
WantedBy=multi-user.target
