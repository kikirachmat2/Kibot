[Unit]
Description=KiBot Polymarket Executor Node
After=network-online.target kibot-master.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
ExecStart=/usr/bin/python3 -u Core/Executors/polymarket_executor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-executor-polymarket

[Install]
WantedBy=multi-user.target
