[Unit]
Description=KiBot Sovereign Janitor (Self-Healing)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env
EnvironmentFile=-/home/ubuntu/KiBot/.env.kiv
ExecStart=/usr/bin/python3 -m Core.Support.sovereign_janitor
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
