[Unit]
Description=KiBot Sovereign Master Node (Batam)
After=network-online.target redis-server.service ollama.service
Wants=network-online.target redis-server.service ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env
EnvironmentFile=-/home/ubuntu/KiBot/.env.kiv
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
ExecStart=/home/ubuntu/KiBot/.venv/bin/python3 -u MasterNode.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Restart=always
RestartSec=10s
TimeoutStopSec=15s
Nice=-5
CPUWeight=500
MemoryMax=2000M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-master

[Install]
WantedBy=multi-user.target
