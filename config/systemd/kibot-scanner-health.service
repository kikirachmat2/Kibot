[Unit]
Description=KiBot Scanner Health Writer
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=/home/ubuntu/KiBot/.env
ExecStart=/home/ubuntu/KiBot/.venv/bin/python3 -m Core.Scanner.scanner_health_runner
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
