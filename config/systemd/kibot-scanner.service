[Unit]
Description=KiBot Centralized Scanner Engine
After=network-online.target kibot-master.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env
EnvironmentFile=-/home/ubuntu/KiBot/.env.kiv
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=.
Environment=KIBOT_INDO_BINANCE_LEADLAG_AGGRESSIVE_MODE=true
Environment=KIBOT_INDO_BINANCE_LEADLAG_BOOTSTRAP_MODE=true
ExecStart=/home/ubuntu/KiBot/.venv/bin/python3 -u Core/Scanner/engine.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-scanner

[Install]
WantedBy=multi-user.target
